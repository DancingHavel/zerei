{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zerei",
  "version": "1.2.0",
  "identifier": "com.zerei.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zerei",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Sua estante de jogos",
    "windows": {
      "nsis": { "languages": ["PortugueseBR"], "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxNjc1N0RFRDI2Nzg4MEMKUldRTWlHZlMzbGRuMFk1QVJYRGQvQzNBa29PWUxLNjZtVDBwYTNBNld1K2ZQaTN0UisxNEZ5TjkK",
      "endpoints": ["https://github.com/DancingHavel/zerei/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
